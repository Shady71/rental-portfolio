# Copy this file to .env.test and fill in real values.
# .env.test is gitignored — never commit real credentials.
# See tests/README.md for exactly what each account needs.

TEST_LANDLORD_EMAIL=
TEST_LANDLORD_PASSWORD=
TEST_TENANT_EMAIL=
TEST_TENANT_PASSWORD=

# Optional — only used by X-04 and X-05, which skip cleanly if these are unset.
TEST_EMPTY_LANDLORD_EMAIL=
TEST_EMPTY_LANDLORD_PASSWORD=
TEST_UNASSIGNED_TENANT_EMAIL=
TEST_UNASSIGNED_TENANT_PASSWORD=
